# Basic reports need no external DB, AI provider, payment provider, or API key.
# Only the exact value 1 enables the stateless, fully free public demo.
# Leave disabled for ordinary local development and before paid launch.
SAJU_PUBLIC_DEMO=0

# Optional explicit trusted origin, required for a custom domain that is not
# supplied by the trusted Vercel system environment variables.
# Development already trusts http://127.0.0.1:4173.
# On Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL
# are accepted only when VERCEL=1. See ../docs/DEPLOYMENT.md.
# APP_ORIGIN=http://127.0.0.1:4173

# Optional OpenAI love consultation. Disabled until deliberately configured.
# Use server environment variables only, never NEXT_PUBLIC_ names.
SAJU_AI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Production requires a private access code of at least 16 characters.
# Optional in development; if supplied, it must also be at least 16 characters.
# This is a separate test access code, not the OpenAI API key.
SAJU_AI_ACCESS_CODE=
