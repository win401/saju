# No external DB, AI model, payment provider, or API key is used yet.
# Only the exact value 1 enables the stateless, fully free public demo.
# Leave disabled for ordinary local development and before paid launch.
SAJU_PUBLIC_DEMO=0

# Optional explicit trusted origin, required for a custom domain that is not
# supplied by the trusted Vercel system environment variables.
# Development already trusts http://127.0.0.1:4173.
# On Vercel, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL / VERCEL_BRANCH_URL
# are accepted only when VERCEL=1. See ../docs/DEPLOYMENT.md.
# APP_ORIGIN=http://127.0.0.1:4173
